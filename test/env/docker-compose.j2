
networks:
  nginx-proxy:
    external: true

services:
  jenkins-gig:
    environment:
      - VIRTUAL_HOST=jenkins.staging.{{ hosts.proxy_domain }}
      - VIRTUAL_PORT=8080
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock"
      - "/home/{{ ansible_user }}/jenkins:/var/jenkins_home"
    image: "registry.gitlab.com/mikejw/empathy/jenkins-gig:{% if use_arch == 'pi' %}jdk17-arm64{% else %}jdk17{% endif +%}"
    container_name: "jenkins-jenkins"
    networks:
      - nginx-proxy

  tailscale-nginx:
    image: tailscale/tailscale:latest
    hostname: test-tailscale-nginx-{{ hosts.test_host }}
    environment:
      - TS_AUTHKEY={{ secrets_vals.ts_authkey }}
      - TS_EXTRA_ARGS=--advertise-tags=tag:container
      - TS_STATE_DIR=/var/lib/tailscale
      - TS_USERSPACE=false
    volumes:
      - ${PWD}/tailscale-nginx/state:/var/lib/tailscale
    devices:
      - /dev/net/tun:/dev/net/tun
    cap_add:
      - NET_ADMIN
    restart: unless-stopped
    networks:
      - nginx-proxy

  nginx-proxy:
    image: jwilder/nginx-proxy
    container_name: nginx-proxy
    volumes:
      - "/var/run/docker.sock:/tmp/docker.sock:ro"
      - "/home/{{ ansible_user }}/vhost.d:/etc/nginx/vhost.d"
    depends_on:
      - tailscale-nginx
    network_mode: service:tailscale-nginx

  mysql:
    container_name: mysql
    image: mysql:8.4.4
    volumes:
    - db-data:/var/lib/mysql
    - ./db-logs/log:/var/log/mysql
    - "/etc/localtime:/etc/localtime:ro"
    restart: unless-stopped
    environment:
      - MYSQL_DATABASE=project
      - MYSQL_ROOT_PASSWORD=example
    networks:
      - nginx-proxy

volumes:
  db-data:


