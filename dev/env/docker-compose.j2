#jinja2: trim_blocks:False

---

name: base-docker

volumes:
  npm-cache:

services:
  cache:
    container_name: cache
    image: memcached:1.6.10
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    ports:
      - 11211:11211
  app:
    container_name: app
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    image: registry.gitlab.com/mikejw/empathy/franken-dev-wnode:{% if use_arch == 'pi' %}arm64{% else %}latest{% endif +%}
    environment:
      - VIRTUAL_HOST={{ use_host }}
      - VIRTUAL_PORT=80
    volumes:
      - {{ code_dir }}/{{ use_project }}:/var/www/project
      - /etc/localtime:/etc/localtime:ro
      - npm-cache:/tmp/npm-cache
    user: "${UID}:${GID}"  

  tooling:
    image: registry.gitlab.com/mikejw/empathy/franken-dev-wnode:{% if use_arch == 'pi' %}arm64{% else %}latest{% endif +%}
    entrypoint: sh
    user: "${UID}:${GID}"
    working_dir: /var/www/project
    volumes:
      - {{ code_dir }}/{{ use_project }}:/var/www/project
      - /etc/localtime:/etc/localtime:ro
      - npm-cache:/tmp/npm-cache
    environment:
      HOME: /var/www/project  

  # TODO: add log rotation
  app-log:
    container_name: app-log
    platform: linux/x86_64
    image: alpine:latest
    volumes:
      - {{ code_dir }}/{{ use_project }}/logs/main.log:/home/main.log
    command: tail -f /home/main.log
        
  db:
    container_name: db
{% if use_arch != 'pi' %}
    platform: linux/x86_64
{% endif %}
    image: mysql:8.4.4
    volumes:
      - "./db/log:/var/log/mysql"
      #- "./db/default.cnf:/etc/mysql/conf.d/default.cnf"
      - /etc/localtime:/etc/localtime:ro
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=example
      - MYSQL_DATABASE=project
    ports:
      - 3306:3306

  # Headless Chromium with an MCP server on http://127.0.0.1:8931/mcp.
  # The browser reaches the dev sites through the host proxy.
  playwright-mcp:
    container_name: playwright-mcp
    image: mcr.microsoft.com/playwright/mcp
    init: true
    stdin_open: true
    shm_size: "2gb"
    entrypoint: ["node", "/app/cli.js"]
    command:
      - --headless
      - --browser
      - chromium
      - --no-sandbox
      - --port
      - "8931"
      - --host
      - 0.0.0.0
      - --allowed-hosts
      - "*"
      - --shared-browser-context
      - --image-responses
      - allow
      - --output-dir
      - /output
    ports:
      - "127.0.0.1:8931:8931"
    volumes:
      - /tmp/playwright-mcp:/output
    extra_hosts:
      - "www.dev.org:host-gateway"
      - "cms.dev.org:host-gateway"
{% if use_host not in ['www.dev.org', 'cms.dev.org'] %}
      - "{{ use_host }}:host-gateway"
{% endif %}
    depends_on:
      - proxy
      - app


{{ partial_text }}


# if using 'global' nginx proxy setup
# this container is not required
# and specify (uncomment) the network settings below
  proxy:
    image: jwilder/nginx-proxy
    container_name: proxy
    ports:
      - 80:80
    volumes:
      - /var/run/docker.sock:/tmp/docker.sock:ro
      - ./env/vhost.d:/etc/nginx/vhost.d

